# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/mits_hub

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Server
NODE_ENV=production
PORT=3000

# IUMS (Result Fetching)
IUMS_BASE_URL=https://iums.mitsgwalior.in
IUMS_FETCH_TIMEOUT=10000

# Security
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin
ADMIN_EMAIL=admin@mitshub.com

# Frontend
FRONTEND_URL=https://yourdomain.com

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging
LOG_LEVEL=info
