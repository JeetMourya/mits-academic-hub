# MongoDB
MONGODB_URI=mongodb://YOUR_MONGODB_URI

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Server
NODE_ENV=production
PORT=3000

# IUMS (Result Fetching)
IUMS_BASE_URL=https://your-iums-host.example
IUMS_FETCH_TIMEOUT=10000

# Security
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FETCH_RATE_LIMIT_MAX=40

# Admin
# First-admin seeding (only used when the database has no admin yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_min_10_chars

# Frontend
FRONTEND_URL=https://your-frontend.example

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Logging
LOG_LEVEL=info
