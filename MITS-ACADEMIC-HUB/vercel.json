{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mits-academic-hub.onrender.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
